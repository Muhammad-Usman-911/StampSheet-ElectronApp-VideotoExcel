{
  "name": "stampsheet",
  "productName": "StampSheet",
  "version": "1.0.0",
  "description": "Reads the date and time burned into CCTV/NVR videos (on this computer or in MEGA) and logs name, date, start/end time and duration into Excel.",
  "author": {
    "name": "StampSheet"
  },
  "homepage": "https://github.com/Muhammad-Usman-911/StampSheet-ElectronApp-VideotoExcel",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammad-Usman-911/StampSheet-ElectronApp-VideotoExcel.git"
  },
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "vite build && electron . --no-sandbox",
    "dev": "node scripts/dev.js",
    "build:ui": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test:video": "node scripts/test-video.js",
    "dist": "vite build && electron-builder --publish never",
    "test:ocr": "node scripts/check-ocr.js",
    "test:mega": "node scripts/test-mega.js",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "release": "node scripts/check-release.js && vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "megajs": "^1.3.10",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.11.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "com.stampsheet.app",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "ui-dist/**",
      "package.json",
      "!node_modules/ffprobe-static/bin/**",
      "node_modules/ffprobe-static/bin/${platform}/${arch}/**",
      "!**/*.{md,map,ts}",
      "!**/{test,tests,__tests__,docs,example,examples}/**"
    ],
    "productName": "StampSheet",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Muhammad-Usman-911",
        "repo": "StampSheet-ElectronApp-VideotoExcel",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StampSheet"
    }
  }
}
